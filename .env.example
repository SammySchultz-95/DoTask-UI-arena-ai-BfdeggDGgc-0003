# DoTask API base URL used directly by the browser. Leave empty to call the
# same origin (recommended — the Next dev server proxies /api/v1 when
# API_PROXY_TARGET is set below).
NEXT_PUBLIC_API_URL=

# Backend origin that the Next dev server proxies /api/v1/* to, e.g.
#   API_PROXY_TARGET=http://localhost:8080 npm run dev
API_PROXY_TARGET=
